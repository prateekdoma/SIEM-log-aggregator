# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Lab SSH accounts -----------------------------------------------------
# admin is the weak-password brute-force target.
SSH_ADMIN_USER=admin
SSH_ADMIN_PASS=password123
# Normal users for traffic-gen (comma-separated), all sharing one strong pass.
SSH_NORMAL_USERS=alice,bob,carol
SSH_NORMAL_PASS=Str0ng-Pass-9x!

# --- DVWA database --------------------------------------------------------
DVWA_DB_ROOT_PASS=dvwa-root-pw
DVWA_DB_PASS=dvwa-app-pw

# --- Attacker -------------------------------------------------------------
# 0 = run scenarios only on demand. > 0 = also loop A1-A3 every N minutes.
ATTACK_INTERVAL_MIN=0

# --- Detection thresholds (used from block 3 on) --------------------------
BF_FAIL_COUNT=10
BF_WINDOW_S=60
SPRAY_USERS=5
SPRAY_WINDOW_S=300
VALID_LOOKBACK_S=600
COOLDOWN_S=300

# --- Kafka retention (used from block 2 on) -------------------------------
KAFKA_LOG_RETENTION_HOURS=2
KAFKA_LOG_RETENTION_BYTES=104857600
KAFKA_LOG_SEGMENT_BYTES=16777216

# --- OTX enrichment (block 4) ---------------------------------------------
# Leave blank here. In block 4 the real key goes in .env ONLY (not this file).
# With no key, every event is tagged `unknown` and the pipeline still runs.
OTX_API_KEY=
